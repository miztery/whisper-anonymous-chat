rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    // Public profile documents contain aliases only. Never put email addresses here.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'avatarSeed', 'createdAt'])
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarSeed']);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(username);
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'description', 'icon', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
          || (signedIn() && request.resource.data.createdBy == 'system');
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage']);
      allow delete: if false;

      match /messages/{messageId} {
        function chatMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if chatMember();
        allow create: if chatMember()
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}